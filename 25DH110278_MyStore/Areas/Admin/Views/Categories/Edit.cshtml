@model _25DH110278_MyStore.Models.Category

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">CẬP NHẬT DANH MỤC</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal col-md-12">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @* Lưu ngầm CategoryID để khi bấm Lưu, Controller biết đang sửa danh mục nào *@
        @Html.HiddenFor(model => model.CategoryID)
        @Html.Partial("PVCreateEditCategory", Model)
    </div>
}